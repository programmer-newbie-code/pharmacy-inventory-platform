# Dart/Flutter build artifacts
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
coverage/

# Generated code — regenerated by build_runner / `flutter pub get` (l10n.yaml has
# synthetic-package: false, so these land in lib/ instead of .dart_tool/), never committed
*.g.dart
*.freezed.dart
lib/l10n/app_localizations*.dart

# ponytail: platform folders regenerated by `flutter create --platforms=... .` in CI
# and locally. Stop ignoring these once a native customization (app icon, permission,
# signing config) needs to be committed and hand-edited.
/ios/
/macos/
/linux/

# IDE
.idea/
.vscode/
*.iml

# Keystores & Credentials
*.jks
*.keystore
key.properties
